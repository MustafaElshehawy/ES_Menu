{
  "name": "dinesmart-menu-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant restaurant menu platform",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./tailwind.generated.css --minify",
    "check": "node --check server.js && node --check dashboard.js && node --check shared.js",
    "test": "node --test",
    "test:preview": "node tests/preview-server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "caniuse-lite": "^1.0.30001815",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.1"
  }
}
